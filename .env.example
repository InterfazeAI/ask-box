APP_URL=https://your-tunnel-or-vercel-url
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Optional dev shortcut: Box Developer Token (~60 min) to skip OAuth. Put the real value in .env.local, not here.
BOX_DEVELOPER_TOKEN=
BOX_REDIRECT_URI=${APP_URL}/api/box/oauth/callback
BOX_WEBHOOK_PRIMARY_KEY=
BOX_WEBHOOK_SECONDARY_KEY=
# Dev-only: set to "true" to skip webhook signature verification (INSECURE, local testing only).
BOX_WEBHOOK_SKIP_VERIFY=
INTERFAZE_API_KEY=
INTERFAZE_BASE_URL=https://api.interfaze.ai/v1
JIGSAWSTACK_API_KEY=
# Embedding v2 vector size (32–4096). MUST equal your Upstash Vector index dimension.
JIGSAWSTACK_EMBED_DIMENSIONS=4096
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
